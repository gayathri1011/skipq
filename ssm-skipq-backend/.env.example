PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ssm-skipq?retryWrites=true&w=majority

# Client (CORS) — comma-separated frontend URLs, no trailing slash
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=your-long-random-secret-here
JWT_EXPIRES_IN=30d

# Razorpay (test mode — no bank needed for development)
# Sign up at https://dashboard.razorpay.com → switch to Test Mode → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Cloudinary (menu image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Sign-In (Web OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Firebase Admin (paste full service account JSON on one line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
